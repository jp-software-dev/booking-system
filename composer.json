{
    "name": "jp-software-dev/booking-system",
    "description": "MediAgenda: sistema de gestión de citas médicas en PHP.",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "dompdf/dompdf": "^3.1",
        "minishlink/web-push": "^11.0",
        "nyholm/psr7": "^1.8",
        "phpmailer/phpmailer": "^7.0",
        "symfony/http-client": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/funciones.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
