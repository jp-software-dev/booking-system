# PLANTILLA DE CONFIGURACIÓN DE MEDIAGENDA
# Copia este archivo como .env y llena los valores reales. El .env nunca se sube a git.

# Entorno: "local" muestra errores en pantalla; "production" los oculta y exige HTTPS en la cookie de sesión.
APP_ENV=local

# URL pública de la raíz del proyecto (sin "/" final). Se usa en los enlaces de los correos.
URL_BASE=http://localhost/app_gestor_citas

# Base de datos. DB_DRIVER: mysql (XAMPP, por defecto) o pgsql (PostgreSQL / Supabase).
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agendamedica_db
DB_USER=root
DB_PASS=
# Solo PostgreSQL: disable, prefer o require (Supabase exige require).
DB_SSLMODE=prefer

# Sesiones: "files" (por defecto) o "database" (necesario en Vercel, que no conserva archivos).
SESSION_DRIVER=files

# true solo detrás de un proxy de confianza (Vercel): toma la IP real del cliente de X-Forwarded-For.
TRUST_PROXY=false

# Modo demostración: aviso en todas las páginas, cuentas de prueba en el login y
# reinicio de datos. ¡Nunca lo actives con una base de datos real!
DEMO_MODE=false
# Secreto de las tareas programadas: reinicio diario de la demo (api/demo_reset.php)
# y envío de recordatorios cada minuto (api/enviar_recordatorios.php).
CRON_SECRET=

# Notificaciones push de las tomas (Web Push). Genera el par de claves una vez con:
#   php -r 'require "vendor/autoload.php"; print_r(Minishlink\WebPush\VAPID::createVapidKeys());'
# (en Windows define antes OPENSSL_CONF=C:\xampp\php\extras\ssl\openssl.cnf).
# VAPID_SUBJECT identifica al remitente: la URL del sitio o "mailto:correo".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://tudominio.com

# Correo: "smtp" envía los correos; "log" solo los escribe en el log de PHP (desarrollo).
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=contraseña-de-aplicacion
SMTP_FROM=tu-cuenta@gmail.com

# Correo que recibe el aviso de cada cita nueva. Vacío = no se envía el aviso.
ADMIN_EMAIL=

# Datos que se muestran en la página de contacto. Si se dejan sin definir, se ven textos de ejemplo.
CONTACTO_TELEFONO=Tu número
CONTACTO_EMAIL=correo@tudominio.com
CONTACTO_UBICACION=Tu ciudad
