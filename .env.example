# PLANTILLA DE CONFIGURACIÓN DE MEDIAGENDA
# Copia este archivo como .env y llena los valores reales. El .env nunca se sube a git.

# Entorno: "local" muestra errores en pantalla; "production" los oculta y exige HTTPS en la cookie de sesión.
APP_ENV=local

# URL pública de la raíz del proyecto (sin "/" final). Se usa en los enlaces de los correos.
URL_BASE=http://localhost/app_gestor_citas

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_NAME=agendamedica_db
DB_USER=root
DB_PASS=

# Correo: "smtp" envía los correos; "log" solo los escribe en el log de PHP (desarrollo).
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=contraseña-de-aplicacion
SMTP_FROM=tu-cuenta@gmail.com

# Correo que recibe el aviso de cada cita nueva. Vacío = no se envía el aviso.
ADMIN_EMAIL=
