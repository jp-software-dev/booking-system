# .htaccess DE LA RAÍZ DEL PROYECTO
#
# La raíz contiene /public (vistas) y /api (endpoints que el navegador llama
# directamente), así que no se puede denegar todo el árbol. En su lugar se
# bloquean aquí las carpetas internas y los archivos ocultos o de configuración.
#
# RECOMENDACIÓN: lo ideal es que el DocumentRoot del servidor apunte a una
# carpeta que solo contenga lo público. Mientras apunte a la raíz del proyecto,
# estas reglas (y los .htaccess de cada carpeta) son la barrera entre el código
# interno e Internet.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # La raíz del sitio abre la aplicación (las páginas viven en /public).
    # %{REQUEST_URI} conserva la subcarpeta si el proyecto no está en la raíz del dominio.
    RewriteRule ^$ %{REQUEST_URI}public/ [R=302,L]

    # Archivos y carpetas ocultas (.git, .env, .claude, .hintrc...), salvo /.well-known.
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

    # Carpetas internas: configuración, migraciones, código fuente y dependencias.
    # (vendor/ no trae .htaccess propio porque lo crea Composer.)
    RewriteRule ^(config|database|src|vendor)(/|$) - [F,L]
</IfModule>

# Archivos de configuración y documentación del proyecto.
<FilesMatch "^(\.env.*|composer\.(json|lock)|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
