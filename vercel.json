{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "framework": null,
  "buildCommand": "mkdir -p dist/public && cp -R public/assets dist/public/assets && cp public/sw.js public/manifest.webmanifest dist/public/",
  "outputDirectory": "dist",
  "functions": {
    "api/vercel.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/public/assets/(css|js|images|videos)/([A-Za-z0-9_.-]+)",
      "dest": "/public/assets/$1/$2",
      "headers": {
        "cache-control": "public, max-age=86400",
        "x-content-type-options": "nosniff"
      }
    },
    {
      "src": "/public/sw\\.js",
      "dest": "/public/sw.js",
      "headers": {
        "cache-control": "no-cache",
        "content-type": "text/javascript; charset=utf-8",
        "x-content-type-options": "nosniff"
      }
    },
    {
      "src": "/public/manifest\\.webmanifest",
      "dest": "/public/manifest.webmanifest",
      "headers": {
        "cache-control": "public, max-age=3600",
        "content-type": "application/manifest+json",
        "x-content-type-options": "nosniff"
      }
    },
    {
      "src": "/favicon\\.ico",
      "dest": "/public/assets/images/favicon.ico",
      "headers": {
        "cache-control": "public, max-age=86400",
        "x-content-type-options": "nosniff"
      }
    },
    {
      "src": "/apple-touch-icon(-precomposed)?\\.png",
      "dest": "/public/assets/images/apple-touch-icon.png",
      "headers": {
        "cache-control": "public, max-age=86400",
        "x-content-type-options": "nosniff"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/vercel.php",
      "headers": {
        "x-content-type-options": "nosniff",
        "referrer-policy": "strict-origin-when-cross-origin",
        "x-frame-options": "SAMEORIGIN"
      }
    }
  ],
  "crons": [
    { "path": "/api/demo_reset.php", "schedule": "0 9 * * *" }
  ]
}
