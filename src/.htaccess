# Deniega el acceso directo por navegador a todo /src (Controllers, Helpers, Models,
# Services, views). Ninguno de estos archivos debe servirse directamente; solo se
# incluyen desde PHP (por /public o /api).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
