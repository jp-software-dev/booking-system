# SECRETOS Y CONFIGURACIÓN LOCAL
.env
.env.*
!.env.example
config/conexion.php
auth.json

# Certificados y llaves privadas
*.pem
*.key
*.p12
*.pfx
*.crt

# DEPENDENCIAS
vendor/
node_modules/

# SALIDA DEL BUILD DE VERCEL (copia de public/assets)
/dist/

# NOTA: composer.lock SÍ se versiona en aplicaciones.
# Garantiza que todos instalen exactamente las mismas versiones
# de dompdf y PHPMailer (trazabilidad ante un CVE).

# BASE DE DATOS
*.sqlite
*.db

# Dumps con datos reales: NUNCA se versionan
database/*dump*.sql
database/*backup*.sql
database/citas.sql

# Las migraciones SÍ se versionan (database/migration_*.sql)
# No agregar aquí ninguna regla que las ignore.

# ARCHIVOS DE RESPALDO (riesgo de exposición de código fuente)
*.bak
*.old
*.orig
*.save
*.backup
*.copy
*.php.txt
*~
~$*

# Respaldos comprimidos olvidados en el webroot
*.zip
*.rar
*.7z
*.tar
*.tar.gz

# LOGS Y CACHÉ
*.log
error_log
php_errors.log
*.cache
logs/
.phpunit.result.cache

# EXPORTACIONES CON DATOS DE PACIENTES
exports/
reportes/
*.csv
Historial_Medico_*.pdf

# SCRIPTS TEMPORALES DE DESARROLLO
test_*.php
hash_*.php
fix_*.php
nuevo_*.php
verificar.php
debug_*.php
temp_*.php
phpinfo.php

# SISTEMA OPERATIVO (Windows / OneDrive / macOS)
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.tmp

# ENTORNOS DE DESARROLLO
.vscode/
.idea/
.history/
*.sublime-*
*.code-workspace
*.swp
*.swo